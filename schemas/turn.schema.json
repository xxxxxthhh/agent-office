{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Office turn response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "A concise, evidence-based account of work completed or findings."
    },
    "status": {
      "type": "string",
      "enum": ["working", "blocked", "done"]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "to": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["to", "body"]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "needsUser": {
      "type": "boolean"
    }
  },
  "required": ["summary", "status", "messages", "artifacts", "needsUser"]
}
